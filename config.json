			"dec": 0,
			"flashPoint":7100
		},
		{
			"header": "Speed",
			"unit": "km/h",
			"obdPID": 13
		},
		{
			"header": "TPS",
			"unit": "%",
			"obdPID": "0x11"
		},
		{
			"header": "MAP",
			"unit": "kPa",
			"obdPID": 11
		},
		{
			"header": "Fuel pressure",
			"unit": "kPa",
