			"autoLogPoint": 60,
			"eventsPerSecond": 0.1
		},
		{
			"header": "Coolant Temp",
			"unit": "°C",
			"canId": "0x420",
			"offset": 0,
			"length": 1,
			"expr": "x-40",
			"autoLogPoint":110,
			"flashPoint":110,
			"warningString": "CAR IS HOT IDIOT",
    		"warningPoint": 105
		},
		{
			"header":"Car is cold",
			"alias":"",
			"expr":"((x>3000)&&(y<80))",
			"x":"Engine Speed",
			"y":"Coolant Temp",
			"hidden": true,
			"noLog": true,
			"warningString": "CAR IS COLD IDIOT",
    		"warningPoint": 0.9
		},
		{
			"header": "cc_active",
			"canId": "0x165",
			"offset": 0,
			"length": 1,
			"expr": "x==70",
			"hidden": true,
			"noLog": true,
			"_note": ""
		},
			{
			"header": "limit_active",
			"canId": "0x165",
			"offset": 5,
			"length": 1,
			"expr": "x==144",
			"hidden": true,
			"noLog": true,
			"_note": ""
		},
		{
			"header": "limit_cc_active",
			"x":"cc_active",
			"y":"limit_active",
			"expr": "x || y",
			"hidden": true,
			"noLog": true,
			"_note": ""
		},
		{
			"header": "Ignition on",
			"canId": "0x50",
			"offset": 0,
			"length": 1,
			"expr": "sleep(x == 0)",
			"hidden": true,
			"noLog": true,
			"_note": "0 = off, 1= acc, 2 = ignition"
		},

		{
			"header":"cc_plus_btn",
			"canId":"0x09D",
			"offset": 0,
			"length": 1,
			"expr": "x==8",
			"hidden": true,
			"noLog": true
		},
		{
			"header": "btn_press",
			"unit": "b",
			"expr": "buttonPress(x && !y,0,0,0)",
			"x": "cc_plus_btn", 
			"y": "limit_cc_active",
			"hidden": true,
			"noLog": true
		},
		{
			"header": "Lateral G",
			"alias": "Lat G",
			"expr": "filter(\"Accel X\", 5)",
			"dec": 2
		},
		{
			"header": "Longitudinal G",
			"alias": "Lon G",
			"expr": "-filter(\"Accel Z\", 5)", 
			"dec": 2
		},
		{
			"header": "Brightness",
			"expr": "setBrightness(lutTable(\"Brightness\", x))",
			"canId": "0x9A",
			"offset": 0,
			"length": 1,
			"hidden": true,
			"noLog": true,
			"lutTable": [
				{
					"x": 0,
					"y": 90,
					"_note": "off"
				},
				{
					"x": 16,
					"y": 90,
					"_note": "drl"
				},
				{
					"x": 32,
					"y": 40,
					"_note": "parking lights"
				},
				{
					"x": 48,
					"y": 40,
					"_note": "low beam"
				},
				{
					"x": 192,
					"y": 40,
					"_note": "high beam"
				}
			]
		}
	]
